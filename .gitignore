# ---------------------------------------------------------------------------
# Secrets. NOTHING matching these patterns may ever be committed.
# .env.example is the ONLY .env* file that is tracked, and it holds placeholders.
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example

# Local credential stores / key material
*.pem
*.key
*.p12
*.pfx
credentials.json
secrets.json
service-account*.json

# ---------------------------------------------------------------------------
# FundingPips execution telemetry (live calibration data)
# Spread samples, execution profile, calibration report. Never committed: it is
# machine- and session-specific, and it is not alpha evidence.
# ---------------------------------------------------------------------------
data/execution/
data/trades/
