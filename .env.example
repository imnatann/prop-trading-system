# =============================================================================
# QuantumPartners - environment template
# Copy this file to .env (which is GITIGNORED) and fill in real values.
#
# NEVER COMMIT CREDENTIALS. NEVER PASTE THEM INTO SOURCE CODE, TESTS, DOCS,
# OR CHAT. Every value below is a PLACEHOLDER, not a real secret.
# =============================================================================

# Execution Mode: "DEV" (Mock Broker simulation) or "LIVE" (Real MT5 on Windows VPS)
APP_MODE=DEV
LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# FundingPips Free Trial on MetaTrader 5  (EURUSD)
# -----------------------------------------------------------------------------
# FUNDINGPIPS_MT5_LOGIN is the MT5 ACCOUNT NUMBER, NOT the email address.
FUNDINGPIPS_MT5_LOGIN=
# Use the TRADING password. The INVESTOR password is read-only and is NEVER used
# by the execution engine - do not put it here.
FUNDINGPIPS_MT5_PASSWORD=
# Fixed by the execution layer. Changing this makes the adapter refuse to connect.
FUNDINGPIPS_MT5_SERVER=FundingPips-Trial

# Optional: full path to terminal64.exe (Windows only). Leave blank to let the
# MetaTrader5 package locate the terminal itself.
FUNDINGPIPS_MT5_PATH=

# SAFETY: real trading is DISABLED unless this is exactly "true".
# Setting it to true is NOT sufficient on its own - order submission ALSO requires
# an explicit command flag (e.g. --allow-order). Two independent opt-ins.
FUNDINGPIPS_ALLOW_TRADING=false

# Which execution adapter the factory builds. Leave as-is for FundingPips MT5.
# Other values: mt5_legacy | mock
EXECUTION_PROVIDER=fundingpips_mt5

# -----------------------------------------------------------------------------
# Legacy MT5 credentials (used only by APP_MODE=LIVE with the older adapter)
# -----------------------------------------------------------------------------
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
MT5_PATH=

# -----------------------------------------------------------------------------
# Telegram Notifications (optional)
# -----------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# -----------------------------------------------------------------------------
# Historical research data provider - REMOVED.
#
# The TwelveData integration was deleted together with the historical research
# data pipeline. Execution now reads live MT5 data directly, so no research data
# provider credential is needed. If a historical provider is ever reintroduced,
# add its credential HERE as a new gitignored variable - never in source code.
# -----------------------------------------------------------------------------
